{
  "display_information": {
    "name": "Otchetnik",
    "description": "Weekly report reminders for UX writers",
    "background_color": "#3b6fd8"
  },
  "features": {
    "bot_user": {
      "display_name": "otchetnik",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
